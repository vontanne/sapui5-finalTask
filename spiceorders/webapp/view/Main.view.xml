<mvc:View controllerName="choam.spiceorders.controller.Main"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns:core="sap.ui.core"
    xmlns="sap.m"
    xmlns:semantic="sap.f.semantic"
    core:require="{ Decimal: 'sap/ui/model/odata/type/Decimal' }">
    <semantic:SemanticPage id="orderListPage">
        <semantic:titleHeading>
            <Title id="orderListTitle" text="{mainView>/title}" />
        </semantic:titleHeading>
        <semantic:content>
            <List
                id="orderList"
                noDataText="{i18n>orderListNoData}"
                growing="true"
                growingScrollToLoad="true"
                updateFinished=".onUpdateFinished"
                items="{
                    path: '/Orders',
                    parameters: { expand: 'Customer', countMode: 'Inline' },
                    sorter: { path: 'OrderID', descending: true }
                }">
                <infoToolbar>
                    <Toolbar
                        id="orderListInfoToolbar"
                        active="true"
                        visible="{mainView>/isFiltered}"
                        press=".onOpenViewSettings">
                        <Text id="orderListFilterInfo" text="{mainView>/filterInfo}" />
                    </Toolbar>
                </infoToolbar>
                <headerToolbar>
                    <OverflowToolbar id="orderListToolbar">
                        <SearchField
                            id="orderSearchField"
                            placeholder="{i18n>orderSearchPlaceholder}"
                            search=".onSearch">
                            <layoutData>
                                <OverflowToolbarLayoutData
                                    id="orderSearchFieldLayoutData"
                                    minWidth="150px"
                                    maxWidth="240px"
                                    shrinkable="true"
                                    priority="NeverOverflow" />
                            </layoutData>
                        </SearchField>
                        <ToolbarSpacer id="orderListToolbarSpacer" />
                        <Button
                            id="orderFilterButton"
                            icon="sap-icon://filter"
                            type="Transparent"
                            tooltip="{i18n>orderFilterButtonTooltip}"
                            press=".onOpenViewSettings" />
                        <Button
                            id="orderGroupButton"
                            icon="sap-icon://group-2"
                            type="Transparent"
                            tooltip="{i18n>orderGroupButtonTooltip}"
                            press=".onOpenViewSettings" />
                    </OverflowToolbar>
                </headerToolbar>
                <ObjectListItem
                    id="orderListItem"
                    title="{i18n>orderTitle} {OrderID}"
                    number="{ path: 'Total', type: 'Decimal', constraints: { precision: 15, scale: 2 } }"
                    numberUnit="{i18n>currency}">
                    <attributes>
                        <ObjectAttribute id="orderListItemCustomer" text="{Customer/Name}" />
                    </attributes>
                    <firstStatus>
                        <ObjectStatus
                            id="orderListItemStatus"
                            text="{ path: 'Status', formatter: '.formatter.statusText' }"
                            state="{ path: 'Status', formatter: '.formatter.statusState' }" />
                    </firstStatus>
                </ObjectListItem>
            </List>
        </semantic:content>
    </semantic:SemanticPage>
</mvc:View>
