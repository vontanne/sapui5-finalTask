<?xml version="1.0" encoding="utf-8"?>
<edmx:Edmx Version="1.0" xmlns:edmx="http://schemas.microsoft.com/ado/2007/06/edmx"
  xmlns:sap="http://www.sap.com/Protocols/SAPData">
  <edmx:DataServices m:DataServiceVersion="2.0" m:MaxDataServiceVersion="2.0"
    xmlns:m="http://schemas.microsoft.com/ado/2007/08/dataservices/metadata">
    <Schema Namespace="SpiceOrders" xmlns="http://schemas.microsoft.com/ado/2007/05/edm">
      <EntityType Name="Order">
        <Key>
          <PropertyRef Name="OrderID" />
        </Key>
        <Property Name="OrderID" Type="Edm.Int32" Nullable="false" />
        <Property Name="CustomerID" Type="Edm.String" MaxLength="20" />
        <Property Name="OrderDate" Type="Edm.DateTime" sap:display-format="Date" />
        <Property Name="DeliveryDate" Type="Edm.DateTime" sap:display-format="Date" />
        <Property Name="Status" Type="Edm.String" MaxLength="20" />
        <Property Name="Total" Type="Edm.Decimal" Precision="15" Scale="2" />
        <NavigationProperty Name="Customer" Relationship="SpiceOrders.Order_Customer"
          FromRole="Order" ToRole="Customer" />
        <NavigationProperty Name="Items" Relationship="SpiceOrders.Order_Items"
          FromRole="Order" ToRole="Items" />
      </EntityType>

      <EntityType Name="OrderItem">
        <Key>
          <PropertyRef Name="ItemID" />
        </Key>
        <Property Name="ItemID" Type="Edm.Int32" Nullable="false" />
        <Property Name="OrderID" Type="Edm.Int32" />
        <Property Name="ProductID" Type="Edm.String" MaxLength="20" />
        <Property Name="Quantity" Type="Edm.Int32" />
        <Property Name="Unit" Type="Edm.String" MaxLength="10" />
        <Property Name="UnitPrice" Type="Edm.Decimal" Precision="15" Scale="2" />
        <NavigationProperty Name="Product" Relationship="SpiceOrders.OrderItem_Product"
          FromRole="OrderItem" ToRole="Product" />
      </EntityType>

      <EntityType Name="House">
        <Key>
          <PropertyRef Name="HouseID" />
        </Key>
        <Property Name="HouseID" Type="Edm.String" Nullable="false" MaxLength="20" />
        <Property Name="Name" Type="Edm.String" MaxLength="40" />
        <Property Name="Leader" Type="Edm.String" MaxLength="60" />
        <Property Name="Homeworld" Type="Edm.String" MaxLength="40" />
      </EntityType>

      <EntityType Name="Product">
        <Key>
          <PropertyRef Name="ProductID" />
        </Key>
        <Property Name="ProductID" Type="Edm.String" Nullable="false" MaxLength="20" />
        <Property Name="Name" Type="Edm.String" MaxLength="40" />
        <Property Name="Unit" Type="Edm.String" MaxLength="10" />
        <Property Name="UnitPrice" Type="Edm.Decimal" Precision="15" Scale="2" />
      </EntityType>

      <Association Name="Order_Customer">
        <End Role="Customer" Type="SpiceOrders.House" Multiplicity="0..1" />
        <End Role="Order" Type="SpiceOrders.Order" Multiplicity="*" />
        <ReferentialConstraint>
          <Principal Role="Customer">
            <PropertyRef Name="HouseID" />
          </Principal>
          <Dependent Role="Order">
            <PropertyRef Name="CustomerID" />
          </Dependent>
        </ReferentialConstraint>
      </Association>

      <Association Name="Order_Items">
        <End Role="Order" Type="SpiceOrders.Order" Multiplicity="1" />
        <End Role="Items" Type="SpiceOrders.OrderItem" Multiplicity="*" />
        <ReferentialConstraint>
          <Principal Role="Order">
            <PropertyRef Name="OrderID" />
          </Principal>
          <Dependent Role="Items">
            <PropertyRef Name="OrderID" />
          </Dependent>
        </ReferentialConstraint>
      </Association>

      <Association Name="OrderItem_Product">
        <End Role="Product" Type="SpiceOrders.Product" Multiplicity="0..1" />
        <End Role="OrderItem" Type="SpiceOrders.OrderItem" Multiplicity="*" />
        <ReferentialConstraint>
          <Principal Role="Product">
            <PropertyRef Name="ProductID" />
          </Principal>
          <Dependent Role="OrderItem">
            <PropertyRef Name="ProductID" />
          </Dependent>
        </ReferentialConstraint>
      </Association>

      <EntityContainer Name="SpiceOrdersContainer" m:IsDefaultEntityContainer="true">
        <EntitySet Name="Orders" EntityType="SpiceOrders.Order" />
        <EntitySet Name="OrderItems" EntityType="SpiceOrders.OrderItem" />
        <EntitySet Name="Houses" EntityType="SpiceOrders.House"
          sap:creatable="false" sap:updatable="false" sap:deletable="false" />
        <EntitySet Name="Products" EntityType="SpiceOrders.Product"
          sap:creatable="false" sap:updatable="false" sap:deletable="false" />

        <AssociationSet Name="Order_Customer" Association="SpiceOrders.Order_Customer">
          <End Role="Customer" EntitySet="Houses" />
          <End Role="Order" EntitySet="Orders" />
        </AssociationSet>
        <AssociationSet Name="Order_Items" Association="SpiceOrders.Order_Items">
          <End Role="Order" EntitySet="Orders" />
          <End Role="Items" EntitySet="OrderItems" />
        </AssociationSet>
        <AssociationSet Name="OrderItem_Product" Association="SpiceOrders.OrderItem_Product">
          <End Role="Product" EntitySet="Products" />
          <End Role="OrderItem" EntitySet="OrderItems" />
        </AssociationSet>
      </EntityContainer>
    </Schema>
  </edmx:DataServices>
</edmx:Edmx>
